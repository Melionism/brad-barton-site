# Статика Astro (dist/). TLS терминируется снаружи (Cloudflare / reverse-proxy),
# поэтому Caddy слушает plain HTTP на :8080 и не запрашивает сертификаты.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges 127.0.0.1/32 ::1/128
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:8080 {
	root * /srv

	log {
		format json
		output stdout
	}

	# Заменить на реальный домен, если нужен редирект www -> apex.
	@www host www.bradbarton.com
	@trailing path_regexp trailing ^(.+)/$
	@asset path /_astro/*
	@static path *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff *.woff2 *.pdf
	@page not path /_astro/* *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff *.woff2 *.pdf

	route {
		respond /healthz "ok" 200
		redir @www https://bradbarton.com{uri} permanent
		redir @trailing {re.trailing.1} permanent

		encode zstd gzip

		header @asset Cache-Control "public, max-age=31536000, immutable"
		header @static Cache-Control "public, max-age=300, must-revalidate"
		header @page Cache-Control "public, max-age=0, must-revalidate"
		header {
			-Server
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "SAMEORIGIN"
		}

		try_files {path}/index.html {path}.html {path}
		file_server
	}

	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
