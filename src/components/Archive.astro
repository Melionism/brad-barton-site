---
import { archive } from '../content/site';
import { imgSize } from '../lib/imgSize';
const items = archive.items.map((p) => ({ ...p, dim: imgSize(p.src) }));
---
{items.length > 0 && (
  <section class="section" id="archive">
    <div class="wrap">
      <div class="reveal">
        <p class="label">{archive.label}</p>
        <h2 class="h2">{archive.heading}</h2>
      </div>
      <ul class="shots reveal">
        {items.map((p) => (
          <li class:list={['shot', p.size && `shot--${p.size}`]}>
            <figure>
              <div class="shot__img"><img src={p.src} alt={p.alt} width={p.dim.width} height={p.dim.height} loading="lazy" decoding="async" style={p.pos ? `object-position:${p.pos}` : undefined} /></div>
              <figcaption>{p.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .shots {
    list-style: none;
    padding: 0;
    margin: 52px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: clamp(200px, 22vw, 290px);
    grid-auto-flow: dense;
    gap: clamp(16px, 2vw, 26px);
  }
  .shot--wide { grid-column: span 2; }
  .shot--tall { grid-row: span 2; }
  /* снимок в белой рамке с подписью, чуть наискосок */
  .shot figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 10px 10px 0;
    background: #fbf7ee;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .shot:nth-child(3n + 1) figure { --tilt: -0.8deg; }
  .shot:nth-child(3n + 2) figure { --tilt: 0.6deg; }
  .shot:nth-child(4n) figure { --tilt: -0.4deg; }
  .shot figure:hover { transform: rotate(0) translateY(-4px) scale(1.01); box-shadow: var(--shadow-lg); }
  .shot__img { position: relative; flex: 1; min-height: 0; overflow: hidden; background: var(--paper-2); }
  .shot__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shot figcaption {
    padding: 9px 2px 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 44vw; }
  }
  @media (max-width: 480px) {
    .shots { grid-template-columns: 1fr; grid-auto-rows: 70vw; }
    .shot--wide { grid-column: auto; }
    .shot--tall { grid-row: span 2; }
  }
</style>
