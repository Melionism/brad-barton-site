---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icons from '../../components/Icons.astro';
import { blog, site, socials, socialOrder } from '../../content/site';
import { getPosts, formatDate } from '../../lib/blog';

const posts = await getPosts();
const origin = Astro.site ? Astro.site.origin : '';
const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${origin}/blog#blog`,
    url: `${origin}/blog`,
    name: `${site.name} — ${blog.heading}`,
    author: { '@id': `${origin}/#person` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${origin}/blog/${p.id}`,
      datePublished: p.data.date.toISOString(),
    })),
  },
];
---
<Base title={blog.title} description={blog.description} path="/blog" jsonLd={jsonLd}>
  <Nav />
  <main class="section blog">
    <div class="wrap">
      <header class="blog__head reveal">
        <p class="label">{blog.label}</p>
        <h1 class="h2">{blog.heading}</h1>
        <p class="lead blog__lead">{blog.text}</p>
      </header>

      {posts.length > 0 ? (
        <ul class="blog__grid reveal">
          {posts.map((p) => (
            <li>
              <a class="card entry" href={`/blog/${p.id}`}>
                {p.data.cover && (
                  <span class="entry__cover"><img src={p.data.cover} alt={p.data.coverAlt ?? ''} loading="lazy" decoding="async" /></span>
                )}
                <span class="entry__body">
                  <span class="entry__meta">
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                    {p.data.draft && <span class="entry__draft">Draft</span>}
                  </span>
                  <span class="entry__title">{p.data.title}</span>
                  <span class="entry__desc">{p.data.description}</span>
                  <span class="entry__more">Read<Icons name="arrow" /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="blog__empty reveal">
          <p class="blog__empty-title">{blog.emptyTitle}</p>
          <p class="lead">{blog.emptyText}</p>
          <ul class="blog__links">
            {socialOrder.map((k) => (
              <li><a class="btn btn--ghost" href={socials[k].url} target="_blank" rel="noopener"><Icons name={k} />{socials[k].label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .blog__lead { margin-top: 22px; }
  .blog__grid { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .entry { display: flex; flex-direction: column; height: 100%; overflow: hidden; border-width: 2px; border-color: var(--ink); }
  .entry__cover { aspect-ratio: 3 / 2; overflow: hidden; border-bottom: 2px solid var(--ink); background: var(--paper-2); }
  .entry__cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .entry:hover .entry__cover img { transform: scale(1.04); }
  .entry__body { display: flex; flex-direction: column; gap: 10px; flex: 1; padding: 22px 22px 20px; }
  .entry__meta { display: flex; gap: 10px; align-items: center; font-size: 15px; color: var(--ink-3); }
  .entry__draft { font-family: var(--font-display); font-weight: 800; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: var(--accent-ink); padding: 3px 7px 2px; border-radius: 3px; }
  .entry__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(26px, 2.4vw, 32px); line-height: 1; text-transform: uppercase; }
  .entry__desc { flex: 1; color: var(--ink-2); font-size: 17px; line-height: 1.55; }
  .entry__more { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 800; font-size: 17px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); }
  .entry__more :global(svg) { width: 18px; height: 18px; transition: transform 0.3s var(--ease); }
  .entry:hover .entry__more :global(svg) { transform: translateX(4px); }

  .blog__empty { margin-top: 52px; max-width: 760px; padding: clamp(24px, 4vw, 40px); border: 2px solid var(--ink); border-radius: 8px; background: #fbf7ee; }
  .blog__empty-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(30px, 3.4vw, 42px); line-height: 1; text-transform: uppercase; margin-bottom: 14px; }
  .blog__links { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 980px) { .blog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .blog__grid { grid-template-columns: 1fr; } }
</style>
