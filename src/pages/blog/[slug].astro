---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icons from '../../components/Icons.astro';
import { blog, site, socials, socialOrder } from '../../content/site';
import { getPosts, formatDate, readingTime, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const d = post.data;
const origin = Astro.site ? Astro.site.origin : '';
const path = `/blog/${post.id}`;
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${origin}${path}#post`,
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    url: `${origin}${path}`,
    mainEntityOfPage: `${origin}${path}`,
    ...(d.cover ? { image: `${origin}${d.cover}` } : {}),
    author: { '@type': 'Person', '@id': `${origin}/#person`, name: site.name, url: `${origin}/` },
    isPartOf: { '@id': `${origin}/blog#blog` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${origin}/blog` },
      { '@type': 'ListItem', position: 3, name: d.title, item: `${origin}${path}` },
    ],
  },
];
---
<Base
  title={`${d.title} — ${site.name}`}
  description={d.description}
  path={path}
  ogImage={d.cover ?? site.ogImage}
  ogType="article"
  published={d.date.toISOString()}
  jsonLd={jsonLd}
  noindex={d.draft}
>
  <Nav />
  <main class="section post">
    <article class="wrap post__in">
      <nav class="post__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">Blog</a>
      </nav>
      <header class="post__head">
        <p class="post__meta">
          <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)}</span>
          {d.draft && <span class="post__draft">Draft</span>}
        </p>
        <h1 class="h2 post__title">{d.title}</h1>
        <p class="lead post__lead">{d.description}</p>
        {d.tags.length > 0 && (
          <ul class="post__tags" aria-label="Tags">{d.tags.map((t) => <li>{t}</li>)}</ul>
        )}
      </header>

      {d.cover && (
        <figure class="post__cover">
          <img src={d.cover} alt={d.coverAlt ?? ''} fetchpriority="high" decoding="async" />
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      <footer class="post__foot">
        <a class="btn btn--ghost" href="/blog"><Icons name="arrow" class="post__back" />All posts</a>
        <div class="post__follow">
          <p class="post__follow-title">{blog.followHeading}</p>
          <ul>
            {socialOrder.map((k) => (
              <li><a href={socials[k].url} target="_blank" rel="noopener" aria-label={socials[k].label}><Icons name={k} /></a></li>
            ))}
          </ul>
        </div>
      </footer>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .post__in { max-width: 820px; }
  .post__crumbs { display: flex; gap: 10px; margin-bottom: 28px; font-family: var(--font-display); font-weight: 700; font-size: 16px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .post__crumbs a:hover { color: var(--accent-ink); }
  .post__meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 16px; color: var(--ink-3); margin-bottom: 18px; }
  .post__draft { font-family: var(--font-display); font-weight: 800; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: var(--accent-ink); padding: 3px 7px 2px; border-radius: 3px; }
  .post__title { max-width: none; font-size: clamp(40px, 6vw, 72px); }
  .post__lead { margin-top: 20px; }
  .post__tags { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .post__tags li { padding: 5px 11px 4px; border: 2px solid var(--ink); border-radius: 4px; font-family: var(--font-display); font-weight: 800; font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; }
  .post__cover { margin: 40px 0 0; border: 2px solid var(--ink); border-radius: 8px; overflow: hidden; box-shadow: 8px 8px 0 var(--ink); aspect-ratio: 3 / 2; background: var(--paper-2); }
  .post__cover img { width: 100%; height: 100%; object-fit: cover; }

  .post__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; margin-top: 56px; padding-top: 28px; border-top: 2px solid var(--ink); }
  .post__foot :global(.post__back) { transform: rotate(180deg); }
  .post__follow { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .post__follow-title { font-family: var(--font-display); font-weight: 800; font-size: 18px; letter-spacing: 0.08em; text-transform: uppercase; }
  .post__follow ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 8px; }
  .post__follow a { display: grid; place-items: center; width: 46px; height: 46px; border: 2px solid var(--ink); border-radius: 4px; transition: background 0.2s, color 0.2s; }
  .post__follow a:hover { background: var(--ink); color: var(--paper); }
  .post__follow :global(svg) { width: 22px; height: 22px; }

  /* текст статьи из markdown */
  .prose { margin-top: 44px; font-size: clamp(18px, 1.6vw, 20px); line-height: 1.75; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2), .prose :global(h3) { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; line-height: 1; margin-top: 1.8em; }
  .prose :global(h2) { font-size: clamp(30px, 3.4vw, 42px); }
  .prose :global(h3) { font-size: clamp(24px, 2.6vw, 30px); }
  .prose :global(a) { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--ink); }
  .prose :global(blockquote) { margin-inline: 0; padding: 4px 0 4px clamp(18px, 3vw, 28px); border-left: 6px solid var(--accent); font-size: 1.15em; font-weight: 500; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(li::marker) { color: var(--accent-ink); }
  .prose :global(img) { width: 100%; border: 2px solid var(--ink); border-radius: 6px; }
  .prose :global(hr) { border: 0; border-top: 2px solid var(--line-2); margin-block: 2em; }
</style>
