---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Profile from '../components/Profile.astro';
import Background from '../components/Background.astro';
import Principles from '../components/Principles.astro';
import Media from '../components/Media.astro';
import Posts from '../components/Posts.astro';
import Archive from '../components/Archive.astro';
import Roots from '../components/Roots.astro';
import Follow from '../components/Follow.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { homeSchema } from '../lib/schema';

const origin = Astro.site ? Astro.site.origin : '';
---
<Base path="/" jsonLd={homeSchema(origin)}>
  <Nav />
  <main>
    <Hero />
    <Profile />
    <Background />
    <Principles />
    <Media />
    <Posts />
    <Archive />
    <Roots />
    <Follow />
    <Contact />
  </main>
  <Footer />
</Base>
